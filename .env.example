WORDPRESS_DB_NAME=wp_rescue
WORDPRESS_DB_USER=wp_rescue
WORDPRESS_DB_PASSWORD=change_me
MARIADB_ROOT_PASSWORD=change_me

WORDPRESS_HOST=wordpress.example.org
TRAEFIK_NETWORK=rescue_proxy
